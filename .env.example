# Copy this file to `.env` and fill in ONE of the options below.
# The contact form uses the first one that is set (top to bottom).

# Option A — Web3Forms (free, no backend): https://web3forms.com
VITE_WEB3FORMS_KEY=

# Option B — Formspree (free tier): https://formspree.io  (paste the full endpoint URL)
VITE_FORMSPREE_ENDPOINT=

# Option C — plain email. The form opens the visitor's mail app, pre-filled.
VITE_CONTACT_EMAIL=
